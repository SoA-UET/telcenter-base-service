MONGO_URL=mongodb://localhost:27017/???
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# S18 - Forwarded Partner Selection Service
GEMINI_API_KEY=your_gemini_api_key_here
S18_NUM_THREADS=4

# A35a Queue - S01 to S18 (incoming events)
A35A_QUEUE_NAME=s01_s18_events

# A35b Queue - S18 to S01 (outgoing events)
A35B_QUEUE_NAME=s18_s01_events

# A37 Queues - S18 to S07 (RabbitMQ method calls)
A37_REQUEST_QUEUE=s18_s07_requests
A37_RESPONSE_QUEUE=s18_s07_responses

# New environment variables here as needed
