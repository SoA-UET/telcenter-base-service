# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/telcenter_partner_core

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Identity Service Configuration (for JWT verification)
IDENTITY_SERVICE_URL=http://localhost:8000

# JWKS Configuration
JWKS_TTL_IN_MINUTES=10

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5008
FLASK_DEBUG=false

# ==================== S08 METRICS SERVICE ====================

# Queue Names for A03a - S01 Consultation Service Events
S01_EVENTS_QUEUE=s01_events_queue

# Queue Names for A04a - S04 Customer Identity Service Events
S04_EVENTS_QUEUE=s04_events_queue

# Queue Names for A03b - S01 Method Requests/Responses
S08_S01_REQUESTS_QUEUE=s08_s01_requests_queue
S08_S01_RESPONSES_QUEUE=s08_s01_responses_queue

# Queue Names for A04b - S04 Method Requests/Responses
S08_S04_REQUESTS_QUEUE=s08_s04_requests_queue
S08_S04_RESPONSES_QUEUE=s08_s04_responses_queue

# Queue Names for A07 - S07 Partner Management Method Requests/Responses
S08_S07_REQUESTS_QUEUE=s08_s07_requests_queue
S08_S07_RESPONSES_QUEUE=s08_s07_responses_queue

# Queue Names for A17a - S08 Events (published to S14)
S08_EVENTS_QUEUE=s08_events_queue

# Queue Names for A17b - S14 Method Requests/Responses
S14_S08_REQUESTS_QUEUE=s14_s08_requests_queue
S14_S08_RESPONSES_QUEUE=s14_s08_responses_queue

# HTTP Service Configuration
HTTP_PORT=5008
CORE_METRICS_SERVICE_URL=http://localhost:5008

# JWT Authentication - Identity Service URL for JWKS fetching
IDENTITY_SERVICE_URL=http://localhost:5004

# JWKS cache TTL in minutes (default: 10)
JWKS_TTL_IN_MINUTES=10

# Logging
LOG_LEVEL=INFO
