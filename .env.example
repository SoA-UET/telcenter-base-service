# Telcenter Base Service - Environment Variables Configuration

# MongoDB Connection Strings
# Main MongoDB database for conversations and messages
MONGO_URL=mongodb://localhost:27017/telcenter_core

# Partner MongoDB database for customers (S04 Customer Identity Service)
# As per S04 documentation, customers collection uses Partner DB
PARTNER_MONGODB_URI=mongodb://localhost:27017/telcenter_partner

# JWT Configuration
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-secret-key-change-this-in-production

# JWT token expiration time in seconds (default: 3600 = 1 hour)
JWT_EXPIRATION_SECONDS=3600

# Google OAuth Configuration (for S04 Customer Identity Service)
# To get these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one
# 3. Enable the Google+ API
# 4. Go to "Credentials" and create OAuth 2.0 Client ID
# 5. Add authorized redirect URIs (e.g., http://localhost:5000/api/v1/auth/oauth/callback)
# 6. Copy the Client ID and Client Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/callback

# RabbitMQ Configuration
# Connection URL for RabbitMQ message queue service
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Flask Configuration
# Flask secret key for session management
FLASK_SECRET_KEY=your-flask-secret-key-change-this

# Flask environment (development/production)
FLASK_ENV=development

# Flask debug mode (True/False)
FLASK_DEBUG=True

# Server host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Peer Service URLs
# Base URLs for calling other microservices
# S08 Metrics Service
S08_METRICS_SERVICE_URL=http://localhost:5008

# Add other service URLs as needed
# S01_SERVICE_URL=http://localhost:5001
# S02_SERVICE_URL=http://localhost:5002
# etc.
