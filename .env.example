MONGO_URL=mongodb://localhost:27017/???
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# New environment variables here as needed

# ========== S14 Partner Metrics Service Configuration ==========

# Partner identification
PARTNER_ID=your_partner_id_here

# Partner Metrics Service URL (for frontend)
PARTNER_METRICS_SERVICE_URL=http://localhost:5014
PARTNER_METRICS_SERVICE_PORT=5014

# RabbitMQ Queue Names (A17a - Events from S08)
S08_EVENTS_QUEUE=s08_events_queue

# RabbitMQ Queue Names (A17b - Method calls to S08)
S14_S08_REQUESTS_QUEUE=s14_s08_requests_queue
S14_S08_RESPONSES_QUEUE=s14_s08_responses_queue

# Worker threads for event processing
NUM_WORKER_THREADS=4

# JWT Authentication (JWKS-based verification)
IDENTITY_SERVICE_URL=http://localhost:5000
JWKS_TTL_IN_MINUTES=10
