# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/telcenter_partner_core

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Identity Service Configuration (for JWT verification)
IDENTITY_SERVICE_URL=http://localhost:8000

# JWKS Configuration
JWKS_TTL_IN_MINUTES=10

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Authentication (set to true to disable JWT auth for testing)
DISABLE_AUTH=false

# RabbitMQ Queue Names

# A07: S08 -> S07 (Metrics Service -> Partner Management)
A07_REQUESTS_QUEUE=telcenter_a07_requests
A07_RESPONSES_QUEUE=telcenter_a07_responses

# A09a: S16 -> S07 (Authorized Partner Gateway -> Partner Management)
A09A_REQUESTS_QUEUE=telcenter_a09a_requests
A09A_RESPONSES_QUEUE=telcenter_a09a_responses

# A09b: S07 -> S16 (Partner Management -> Authorized Partner Gateway) - Events only
A09B_EVENTS_QUEUE=telcenter_a09b_events

# A37: S18 -> S07 (Forwarded Partner Selection -> Partner Management)
A37_REQUESTS_QUEUE=telcenter_a37_requests
A37_RESPONSES_QUEUE=telcenter_a37_responses

# Number of threads for RabbitMQ consumers
MQ_CONSUMER_THREADS=4
